<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:BetTracker.UI.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="BetTracker.UI.MainWindow"
        Title="BetTracker - Bet Tracking System"
        Width="1000"
        Height="600">
    <TabControl>
        <!-- Bets Tab -->
        <TabItem Header="My Bets">
            <local:BetsView />
        </TabItem>

        <!-- Bookmakers Tab -->
        <TabItem Header="Bookmakers">
            <local:BookmakerView />
        </TabItem>

        <!-- Calculations Tab -->
        <TabItem Header="Calculations">
            <local:CalculationView />
        </TabItem>
    </TabControl>
</Window>
