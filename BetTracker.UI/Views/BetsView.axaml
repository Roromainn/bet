<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BetTracker.UI.Views.BetsView">
    <Border Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <!-- Header with Load Button -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Text="Active Bets" FontSize="18" FontWeight="Bold" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Load Bets"
                        Command="{Binding LoadBetsCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Padding="12,8" />
                <Button Content="Clear Filters"
                        Command="{Binding ClearFiltersCommand}"
                        Padding="8,4"
                        Background="#AAAAAA"
                        Foreground="White" />
                <Button Content="Clear Error"
                        Command="{Binding ClearErrorCommand}"
                        Padding="12,8" />
            </StackPanel>
        </Grid>

        <!-- Place Bet Form -->
        <Border Grid.Row="1"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Padding="12"
                CornerRadius="4">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,*,*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             PlaceholderText="Odds"
                             Text="{Binding NewBetOdds}"
                             ToolTip.Tip="Enter the betting odds (e.g., 2.5, 3.0)" />
                    <TextBox Grid.Column="1"
                             PlaceholderText="Stake"
                             Text="{Binding NewBetStake}"
                             ToolTip.Tip="Enter the stake amount" />
                    <TextBox Grid.Column="2"
                             PlaceholderText="Bet Type"
                             Text="{Binding NewBetType}"
                             ToolTip.Tip="Enter bet type (e.g., FreeBet, RemboursementFreeBet)" />
                    <Button Grid.Column="3"
                            Content="Place Bet"
                            Command="{Binding PlaceBetCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            Padding="12,8" />
                    <Button Grid.Column="4"
                            Content="Reset"
                            Command="{Binding ClearFiltersCommand}"
                            Padding="8,4"
                            Background="#AAAAAA"
                            Foreground="White" />
                </Grid>

                <!-- Odds Error -->
                <TextBlock Text="{Binding OddsError}"
                           Foreground="#CC0000"
                           FontSize="12"
                           IsVisible="{Binding OddsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Stake Error -->
                <TextBlock Text="{Binding StakeError}"
                           Foreground="#CC0000"
                           FontSize="12"
                           IsVisible="{Binding StakeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Bet Type Error -->
                <TextBlock Text="{Binding BetTypeError}"
                           Foreground="#CC0000"
                           FontSize="12"
                           IsVisible="{Binding BetTypeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Border>

        <!-- Error Message -->
        <Border Grid.Row="2"
                Background="#FFE6E6"
                BorderBrush="#FF9999"
                BorderThickness="1"
                Padding="12"
                IsVisible="{Binding ErrorMessage}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#CC0000" />
        </Border>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="3"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Height="4" />

        <!-- Bets ListBox -->
        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Bets}"
                 IsVisible="{Binding !IsLoading}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFFFFF"
                            BorderBrush="#EEEEEE"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding BookmakerName}"
                                           FontWeight="Bold"
                                           FontSize="14" />
                                <TextBlock Text="{Binding BetType}"
                                           FontSize="12"
                                           Foreground="#666666" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding BetStatus}"
                                       Foreground="#666666" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CalculatedEV}"
                                       FontWeight="Bold" />
                            <Button Grid.Column="3"
                                    Content="Delete"
                                    Command="{Binding $parent[ListBox].DataContext.ConfirmDeleteCommand}"
                                    CommandParameter="{Binding .}"
                                    Padding="8,4"
                                    Background="#FF6666"
                                    Foreground="White" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Confirmation Dialog -->
        <Border Grid.Row="3"
                Background="#FFE6E6"
                Padding="16"
                IsVisible="{Binding ShowDeleteConfirm}"
                BorderBrush="#FF8B0000"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,8,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding ConfirmationMessage}" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Delete"
                            Command="{Binding ExecuteDeleteCommand}"
                            Background="Red"
                            Foreground="White"
                            Padding="8,4" />
                    <Button Content="Cancel"
                            Command="{Binding CancelDeleteCommand}"
                            Padding="8,4" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <TextBlock Text="{Binding Bets.Count, StringFormat='Total Bets: {0}'}"
                       Foreground="#666666" />
        </Border>
        </Grid>
    </Border>
</UserControl>
