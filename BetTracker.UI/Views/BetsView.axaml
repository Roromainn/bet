<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BetTracker.UI.Views.BetsView">
    <Border Padding="12">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <!-- Header with Load Button -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Text="Active Bets" FontSize="18" FontWeight="Bold" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Load Bets"
                        Command="{Binding LoadBetsCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Padding="12,8" />
                <Button Content="Clear Error"
                        Command="{Binding ClearErrorCommand}"
                        Padding="12,8" />
            </StackPanel>
        </Grid>

        <!-- Error Message -->
        <Border Grid.Row="1"
                Background="#FFE6E6"
                BorderBrush="#FF9999"
                BorderThickness="1"
                Padding="12"
                IsVisible="{Binding ErrorMessage}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#CC0000" />
        </Border>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="2"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Height="4" />

        <!-- Bets ListBox -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Bets}"
                 IsVisible="{Binding !IsLoading}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFFFFF"
                            BorderBrush="#EEEEEE"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding BookmakerName}"
                                           FontWeight="Bold"
                                           FontSize="14" />
                                <TextBlock Text="{Binding BetType}"
                                           FontSize="12"
                                           Foreground="#666666" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding BetStatus}"
                                       Foreground="#666666" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CalculatedEV}"
                                       FontWeight="Bold" />
                            <Button Grid.Column="3"
                                    Content="Delete"
                                    Command="{Binding $parent[ListBox].DataContext.DeleteBetCommand}"
                                    CommandParameter="{Binding Bet.Id}"
                                    Padding="8,4"
                                    Background="#FF6666"
                                    Foreground="White" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <TextBlock Text="{Binding Bets.Count, StringFormat='Total Bets: {0}'}"
                       Foreground="#666666" />
        </Border>
        </Grid>
    </Border>
</UserControl>
